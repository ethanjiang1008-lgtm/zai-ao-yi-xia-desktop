{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "再熬一下",
  "version": "0.1.0",
  "identifier": "com.zayaoyixia.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "再熬一下",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 560,
        "visible": false,
        "decorations": true,
        "center": true,
        "shadow": true
      },
      {
        "label": "widget",
        "title": "再熬一下 · 桌面卡片",
        "width": 280,
        "height": 170,
        "minWidth": 180,
        "minHeight": 110,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": true,
        "shadow": false,
        "x": 60,
        "y": 80
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "再熬一下",
    "category": "Lifestyle",
    "shortDescription": "桌面上的一件数字小物件，陪打工人熬过一天",
    "longDescription": "把上班转换成实时可视化的收入、进度、目标和游戏反馈，让用户在疲惫、烦躁、想摸鱼的时候获得一点轻松、掌控感和情绪价值。"
  }
}
